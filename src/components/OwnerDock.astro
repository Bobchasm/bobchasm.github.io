---
import { PenSquare, X } from 'lucide-astro';

const { iconImage = '' } = Astro.props;
---

<div class="owner-dock" data-owner-dock>
  <button class="owner-trigger" type="button" aria-haspopup="dialog" aria-controls="owner-login" title="发布入口">
    {iconImage ? <img src={iconImage} alt="" /> : <PenSquare size={17} />}
  </button>
</div>

<dialog class="owner-dialog" id="owner-login" aria-labelledby="owner-login-title">
  <form class="owner-panel" method="dialog">
    <div class="owner-panel-head">
      <h2 id="owner-login-title">本人入口</h2>
      <button class="icon-button" value="cancel" type="submit" title="关闭">
        <X size={18} />
      </button>
    </div>
    <label>
      <span>口令</span>
      <input name="passphrase" type="password" autocomplete="current-password" autofocus />
    </label>
    <p class="owner-error" data-owner-error hidden>请输入口令。</p>
    <button class="button primary" value="publish" type="submit">
      <PenSquare size={18} />
      进入发布页
    </button>
  </form>
</dialog>

<script>
  const dialog = document.querySelector('#owner-login');
  const trigger = document.querySelector('[data-owner-dock] .owner-trigger');
  const form = dialog?.querySelector('form');
  const error = dialog?.querySelector('[data-owner-error]');

  trigger?.addEventListener('click', () => {
    if (dialog instanceof HTMLDialogElement) {
      dialog.showModal();
    }
  });

  form?.addEventListener('submit', (event) => {
    const submitter = event.submitter;
    if (submitter?.value !== 'publish') return;

    event.preventDefault();
    const formData = new FormData(form);
    const passphrase = String(formData.get('passphrase') || '').trim();

    if (!passphrase) {
      error?.removeAttribute('hidden');
      return;
    }

    sessionStorage.setItem('owner-entry', 'local-prototype');
    window.location.href = '/studio/?from=dock';
  });
</script>

<style>
  .owner-dock {
    position: fixed;
    right: max(18px, env(safe-area-inset-right));
    bottom: max(18px, env(safe-area-inset-bottom));
    z-index: 50;
  }

  .owner-trigger {
    width: 38px;
    height: 38px;
    border: 1px solid rgba(23, 23, 23, 0.14);
    border-radius: 8px;
    background: rgba(23, 23, 23, 0.92);
    color: var(--paper);
    padding: 0;
    box-shadow: 0 16px 40px rgba(23, 23, 23, 0.18);
    font: inherit;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .owner-trigger img {
    width: 22px;
    height: 22px;
    object-fit: cover;
    border-radius: 6px;
  }

  .owner-dialog {
    width: min(420px, calc(100% - 32px));
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0;
    background: var(--panel);
    box-shadow: 0 24px 80px rgba(23, 23, 23, 0.24);
  }

  .owner-dialog::backdrop {
    background: rgba(23, 23, 23, 0.36);
    backdrop-filter: blur(4px);
  }

  .owner-panel {
    display: grid;
    gap: 16px;
    padding: 20px;
  }

  .owner-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .owner-panel h2 {
    margin: 0;
    line-height: 1.2;
  }

  .icon-button {
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .owner-panel label {
    display: grid;
    gap: 6px;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .owner-panel input {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 12px 13px;
    font: inherit;
  }

  .owner-error {
    margin: 0;
    color: var(--warm);
    font-size: 0.92rem;
  }
</style>
