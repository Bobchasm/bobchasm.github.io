---
const { item, href, kicker = '' } = Astro.props;
const { title, description, date, tags = [] } = item.data;
---

<article class="card">
  {kicker && <div class="eyebrow">{kicker}</div>}
  <h3><a href={href}>{title}</a></h3>
  <div class="meta">{date.toLocaleDateString('zh-CN')}</div>
  {description && <p>{description}</p>}
  {tags.length > 0 && (
    <div class="tags">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  )}
</article>
