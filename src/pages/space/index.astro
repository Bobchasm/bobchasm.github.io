---
import { getCollection } from 'astro:content';
import { ArrowRight, BookOpen, Code2, PenLine, Sparkles } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import MomentCard from '../../components/MomentCard.astro';

const blog = (await getCollection('blog')).filter((item) => !item.data.draft).sort((a, b) => +b.data.date - +a.data.date);
const notes = (await getCollection('notes')).filter((item) => !item.data.draft).sort((a, b) => +b.data.date - +a.data.date);
const projects = (await getCollection('projects')).filter((item) => !item.data.draft).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const moments = (await getCollection('moments')).filter((item) => !item.data.draft).sort((a, b) => +b.data.date - +a.data.date);
---

<BaseLayout title="个人空间 | BobChasm">
  <section class="hero">
    <div class="site-shell hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">Personal Knowledge Base</div>
        <h1>把学习、项目和日常想法都放在一个自己掌控的地方。</h1>
        <p>
          这里会慢慢长成一个个人主页：有技术问题记录、学习笔记、项目展示，也有一点像朋友圈的随手更新。
        </p>
        <div class="button-row">
          <a class="button primary" href="/notes/"><BookOpen size={18} />看笔记</a>
          <a class="button" href="/blog/"><PenLine size={18} />读博客</a>
        </div>
      </div>
      <div class="hero-panel" aria-label="Profile snapshot">
        <img src="/images/avatar.jpg" alt="Profile avatar" />
        <div>
          <span class="eyebrow">Now</span>
          <p>CS / Math / Physics notes, web experiments, and things worth remembering.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section site-shell">
    <div class="section-head">
      <div>
        <div class="eyebrow">Writing</div>
        <h2>最近博客</h2>
      </div>
      <a class="button" href="/blog/">全部 <ArrowRight size={16} /></a>
    </div>
    <div class="grid two">
      {blog.slice(0, 2).map((item) => <ArticleCard item={item} href={`/blog/${item.slug}/`} />)}
    </div>
  </section>

  <section class="section site-shell">
    <div class="section-head">
      <div>
        <div class="eyebrow">Notes</div>
        <h2>学习笔记</h2>
      </div>
      <a class="button" href="/notes/">分类 <ArrowRight size={16} /></a>
    </div>
    <div class="grid three">
      {notes.slice(0, 3).map((item) => <ArticleCard item={item} href={`/notes/${item.data.category}/${item.slug}/`} kicker={item.data.category} />)}
    </div>
  </section>

  <section class="section site-shell">
    <div class="section-head">
      <div>
        <div class="eyebrow">Builds</div>
        <h2>项目</h2>
      </div>
      <a class="button" href="/projects/">展开 <ArrowRight size={16} /></a>
    </div>
    <div class="grid two">
      {projects.slice(0, 2).map((item) => (
        <article class="card">
          <div class="eyebrow">{item.data.featured ? 'Featured' : 'Project'}</div>
          <h3><a href={`/projects/${item.slug}/`}>{item.data.title}</a></h3>
          <p>{item.data.description}</p>
          <div class="tags">{item.data.tech.map((tech) => <span class="tag">{tech}</span>)}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="section site-shell">
    <div class="section-head">
      <div>
        <div class="eyebrow">Moments</div>
        <h2>动态</h2>
      </div>
      <a class="button" href="/moments/">更多 <ArrowRight size={16} /></a>
    </div>
    <div class="grid two">
      {moments.slice(0, 2).map((item) => <MomentCard item={item} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(90deg, rgba(247, 251, 250, 0.98), rgba(247, 251, 250, 0.72)),
      url('/images/avatar.jpg') right center / auto 120% no-repeat;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.55fr);
    gap: 40px;
    align-items: end;
    min-height: 520px;
    padding: 72px 0 42px;
  }

  .hero-copy h1 {
    font-size: clamp(2.3rem, 7vw, 5.8rem);
    line-height: 0.98;
    margin: 14px 0 20px;
    max-width: 880px;
  }

  .hero-copy p {
    color: var(--muted);
    max-width: 650px;
    font-size: 1.08rem;
  }

  .hero-panel {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.84);
    padding: 16px;
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: 16px;
    align-items: center;
    box-shadow: var(--shadow);
  }

  .hero-panel img {
    width: 84px;
    height: 84px;
    object-fit: cover;
    border-radius: 8px;
  }

  .hero-panel p {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
      min-height: auto;
    }
  }
</style>
