---
import { getCollection } from 'astro:content';
import { ArrowUpRight, BookOpen, Code2, Github, Mail, MapPin, MessageSquareText, PenLine, School } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import KeywordBubbles from '../../components/KeywordBubbles.astro';

const blog = (await getCollection('blog')).filter((item) => !item.data.draft).sort((a, b) => +b.data.date - +a.data.date);
const notes = (await getCollection('notes')).filter((item) => !item.data.draft).sort((a, b) => +b.data.date - +a.data.date);
const projects = (await getCollection('projects'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || +b.data.date - +a.data.date);
const moments = (await getCollection('moments')).filter((item) => !item.data.draft).sort((a, b) => +b.data.date - +a.data.date);
const latestMoment = moments[0];

const noteGroups = [
  ['cs', 'CS', '不限于课程记录、技术栈学习、Tips ...'],
  ['math', 'Mathematics', '也许记录一些常用/有趣的定理或公式叭 ~'],
  ['physics', 'Physics', '哦，Bobchasm 的梦想，可能很难更新'],
  ['void', 'Void', '其他乱七八糟的都丢在这吧，嘻嘻']
];

const keywords = [
  { label: '黑暗森林', size: 126, tone: 0 },
  { label: '相对', size: 82, tone: 1 },
  { label: '三体', size: 92, tone: 3 },
  { label: 'Alice', size: 70, tone: 1 },
  { label: 'Bob', size: 70, tone: 2 },
  { label: '百年孤独', size: 99, tone: 3 }
];
---

<BaseLayout title="Bobchasm">
  <main class="space-page">
    <aside class="profile-drawer" aria-label="Profile drawer">
      <div class="drawer-tab" title="Profile" tabindex="0" aria-label="Profile"></div>
      <div class="profile-drawer-panel">
        <div class="drawer-head">
          <img src="/images/avatar.jpg" alt="Bobchasm avatar" />
          <strong>Bobchasm</strong>
        </div>
        <div class="drawer-facts">
          <p><MapPin size={14} /> 中国 · 天津</p>
          <p><School size={14} /> 天津大学 · 软件学院 · 23级本科生</p>
          <p><BookOpen size={14} /> Major 软件工程 · Minor 数学与应用数学</p>
          <a href="mailto:hello@example.com"><Mail size={14} /> daimingjing142857@tju.edu.cn</a>
          <a href="https://github.com/bobchasm" target="_blank" rel="noreferrer"><Github size={14} /> Bobchasm</a>
        </div>
        <p class="drawer-intro">
          A short self-introduction placeholder. Replace this with your background, interests, current focus, and anything you want visitors to know.
        </p>
      </div>
    </aside>

    <section class="site-shell space-board">
      <div class="space-title">
        <KeywordBubbles keywords={keywords} />
      </div>

      <aside class="identity-slab">
        <img src="/images/avatar.jpg" alt="Bobchasm avatar" />
        <p>I was still watching the sunrise in the snow on a winter night, but you, with your early spring branches and leaves, declared my defeat.</p>
      </aside>

      <section class="panel writing-panel">
        <div class="panel-top">
          <PenLine size={19} />
          <h2>Writing</h2>
          <a href="/blog/" title="All posts"><ArrowUpRight size={16} /></a>
        </div>
        <div class="stack-list">
          {blog.slice(0, 3).map((item) => (
            <a href={`/blog/${item.slug}/`}>
              <strong>{item.data.title}</strong>
              <span>{item.data.date.toLocaleDateString('zh-CN')}</span>
            </a>
          ))}
        </div>
        <div class="panel-ellipsis" aria-hidden="true">...</div>
      </section>

      <section class="panel notes-panel">
        <div class="panel-top">
          <BookOpen size={19} />
          <h2>Learning Map</h2>
          <a href="/notes/" title="All notes"><ArrowUpRight size={16} /></a>
        </div>
        <div class="note-map">
          {noteGroups.map(([key, label, description]) => {
            const count = notes.filter((item) => item.data.category === key).length;
            return (
              <a href={`/notes/${key}/`}>
                <span>{label}</span>
                <p>{description}</p>
                <strong>{count}</strong>
              </a>
            );
          })}
        </div>
      </section>

      <section class="panel projects-panel">
        <div class="panel-top">
          <Code2 size={19} />
          <h2>Projects</h2>
          <a href="/projects/" title="All projects"><ArrowUpRight size={16} /></a>
        </div>
        <div class="project-strip">
          {projects.slice(0, 2).map((item) => (
            <a href={`/projects/${item.slug}/`}>
              <strong>{item.data.title}</strong>
              <span>{item.data.tech.join(' / ')}</span>
            </a>
          ))}
        </div>
        <div class="panel-ellipsis" aria-hidden="true">...</div>
      </section>

      <section class="panel moments-panel">
        <div class="panel-top">
          <MessageSquareText size={19} />
          <h2>Moments</h2>
          <a href="/moments/" title="All moments"><ArrowUpRight size={16} /></a>
        </div>
        {latestMoment ? (
          <a class="moment-feature" href={`/moments/${latestMoment.slug}/`}>
            <div>
              <time>{latestMoment.data.date.toLocaleString('zh-CN', { dateStyle: 'medium', timeStyle: 'short' })}</time>
              <h3>{latestMoment.data.title}</h3>
              <p>{latestMoment.data.text}</p>
            </div>
            {(latestMoment.data.video || latestMoment.data.images?.[0]) && (
              <div class="moment-media-frame">
                {latestMoment.data.video ? (
                  <video src={latestMoment.data.video} muted playsinline preload="metadata"></video>
                ) : (
                  <img src={latestMoment.data.images[0]} alt="" loading="lazy" />
                )}
              </div>
            )}
          </a>
        ) : (
          <a class="moment-feature" href="/moments/">
            <div>
              <time>{new Date().toLocaleDateString('zh-CN')}</time>
              <h3>First moment</h3>
              <p>Nothing has been posted here yet. The first image, video, or short text will appear in this space.</p>
            </div>
          </a>
        )}
      </section>
    </section>
  </main>
</BaseLayout>

<style>
  .space-page {
    padding: 32px 0 12px;
  }

  .profile-drawer {
    position: fixed;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    width: 28px;
    height: 52px;
  }

  .drawer-tab {
    width: 28px;
    height: 52px;
    border: 1px solid var(--line);
    border-left: 0;
    border-radius: 0 8px 8px 0;
    background: rgba(247, 251, 250, 0.92);
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: 0 12px 28px rgba(8, 63, 70, 0.1);
  }

  .drawer-tab::before {
    content: "";
    width: 0;
    height: 0;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    border-left: 9px solid var(--accent-strong);
    transition: transform 160ms ease;
  }

  .profile-drawer:hover .drawer-tab::before {
    transform: rotate(180deg);
  }

  .profile-drawer-panel {
    position: absolute;
    left: 28px;
    top: 50%;
    width: min(300px, calc(100vw - 44px));
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(247, 251, 250, 0.96);
    box-shadow: 0 18px 44px rgba(8, 63, 70, 0.14);
    padding: 14px;
    display: grid;
    gap: 12px;
    opacity: 0;
    pointer-events: none;
    transform: translate(-14px, -50%);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .profile-drawer:hover .profile-drawer-panel,
  .profile-drawer:focus-within .profile-drawer-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translate(0, -50%);
  }

  .drawer-head {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
  }

  .drawer-head img {
    width: 84px;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid var(--line);
  }

  .drawer-head strong {
    color: var(--accent-strong);
    font-family: "Brush Script MT", "Snell Roundhand", "Segoe Script", "Lucida Handwriting", cursive;
    font-size: 1.9rem;
    font-weight: 400;
    font-style: normal;
    letter-spacing: 0;
    line-height: 1;
    transform: rotate(-3deg);
  }

  .drawer-facts {
    display: grid;
    gap: 7px;
  }

  .drawer-facts p,
  .drawer-facts a {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #244542;
    font-size: 0.84rem;
  }

  .drawer-intro {
    margin: 0;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .space-board {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr 0.9fr;
    grid-template-areas:
      "title title identity"
      "writing projects identity"
      "writing notes moments";
    gap: 14px;
  }

  .space-title {
    grid-area: title;
    min-height: 260px;
  }

  .identity-slab {
    grid-area: identity;
    min-height: 100%;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(216, 238, 233, 0.68);
    padding: 16px;
    display: grid;
    align-content: space-between;
    gap: 18px;
  }

  .identity-slab img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid rgba(7, 91, 96, 0.18);
  }

  .identity-slab p {
    margin: 0;
    color: #244542;
    font-size: 0.98rem;
  }

  .panel {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.36);
    padding: 16px;
    min-height: 220px;
  }

  .writing-panel {
    grid-area: moments;
    min-height: 244px;
  }

  .notes-panel {
    grid-area: notes;
    min-height: 256px;
  }

  .projects-panel {
    grid-area: projects;
    align-self: start;
    min-height: 240px;
  }

  .moments-panel {
    grid-area: writing;
    min-height: 454px;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }

  .panel-top {
    display: grid;
    grid-template-columns: 22px 1fr 22px;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    color: var(--accent-strong);
  }

  .writing-panel,
  .projects-panel {
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .panel-ellipsis {
    width: 100%;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1;
    letter-spacing: 0;
    text-align: center;
    padding-top: 8px;
  }

  .panel-top h2 {
    margin: 0;
    font-size: 1rem;
  }

  .stack-list,
  .project-strip {
    display: grid;
    gap: 12px;
  }

  .stack-list a,
  .project-strip a {
    display: grid;
    gap: 5px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 12px;
  }

  .stack-list a:last-child,
  .project-strip a:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .stack-list strong,
  .project-strip strong {
    font-size: 0.98rem;
  }

  .stack-list span,
  .project-strip span,
  .moment-feature time {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .note-map {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .note-map a {
    min-height: 96px;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 11px;
    display: grid;
    align-content: space-between;
    background: #f4fbfa;
  }

  .note-map span {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .note-map p {
    margin: 4px 0 12px;
    color: #263d3b;
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .note-map strong {
    color: var(--accent-strong);
    font-size: 1.4rem;
  }

  .moment-feature {
    min-height: 0;
    height: 100%;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    align-content: start;
    gap: 8px;
  }

  .moment-feature h3 {
    margin: 4px 0 8px;
    font-size: 1.15rem;
    line-height: 1.18;
  }

  .moment-feature p {
    margin: 0;
    color: #263d3b;
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .moment-media-frame {
    position: relative;
    min-height: 0;
    height: 100%;
    overflow: hidden;
    border-radius: 8px;
    border: 1px solid var(--line);
  }

  .moment-media-frame::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 58px;
    background: linear-gradient(180deg, rgba(247, 251, 250, 0), rgba(247, 251, 250, 0.86));
    backdrop-filter: blur(1.5px);
    pointer-events: none;
  }

  .moment-media-frame img,
  .moment-media-frame video {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  @media (max-width: 920px) {
    .space-board {
      grid-template-columns: 1fr;
      grid-template-areas:
        "title"
        "identity"
        "writing"
        "notes"
        "projects"
        "moments";
    }

    .space-title,
    .writing-panel {
      min-height: auto;
    }
  }
</style>
